{
  "manifest_version": 3,
  "name": "NeiroTranslate — live video & stream translator",
  "short_name": "NeiroTranslate",
  "version": "3.4.1",
  "description": "Real-time translation of videos and live streams: translated subtitles and voice-over. Free mode + Gemini Live, ElevenLabs, Yandex SpeechKit.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "tts"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.elevenlabs.io/*",
    "https://tts.api.cloud.yandex.net/*"
  ],
  "background": { "service_worker": "src/background/background.js" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NeiroTranslate",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-translation": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Start / stop translation on the current tab"
    }
  }
}
